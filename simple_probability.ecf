<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration/24" name="simple_probability" uuid="a3e5f0c1-2b4d-11ed-b43e-0242ac120002">
	<description>Type-safe, Design-by-Contract probability and Bayesian reasoning library for Eiffel</description>
	<target name="simple_probability">
		<description>simple_probability library target</description>
		<root all_classes="true"/>
		<option>
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<capability>
			<concurrency support="scoop"/>
			<void_safety support="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY/library/base/base.ecf"/>
		<library name="simple_randomizer" location="$SIMPLE_EIFFEL/simple_randomizer/simple_randomizer.ecf"/>
		<library name="simple_math" location="$SIMPLE_EIFFEL/simple_math/simple_math.ecf"/>
		<cluster name="simple_probability_src" location="src" recursive="true"/>
	</target>
	<target name="simple_probability_tests" extends="simple_probability">
		<description>Test target for simple_probability</description>
		<root class="TEST_APP" feature="make"/>
		<option>
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="executable_name" value="test_app"/>
		<library name="testing" location="$ISE_LIBRARY/library/testing/testing.ecf"/>
		<library name="simple_testing" location="$SIMPLE_EIFFEL/simple_testing/simple_testing.ecf"/>
		<cluster name="simple_probability_test" location="test" recursive="true"/>
	</target>
</system>
